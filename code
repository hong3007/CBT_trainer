<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HE-ONG 쿠폰북</title>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-database-compat.js"></script>

    <style>
        body { font-family: 'Apple SD Gothic Neo', sans-serif; display: flex; flex-direction: column; align-items: center; background-color: #f8f9fa; }
        .coupon-container { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: 50px; width: 300px; }
        .coupon-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid #eee; }
        .coupon-item:last-child { border-bottom: none; }
        .coupon-info { flex-grow: 1; }
        .coupon-name { font-weight: bold; font-size: 1.1rem; }
        .coupon-count { color: #ff6b6b; font-size: 0.9rem; }
        button { background-color: #4dabf7; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; transition: 0.2s; }
        button:hover { background-color: #339af0; }
        button:disabled { background-color: #adb5bd; cursor: not-allowed; }
    </style>
</head>
<body>

<div class="coupon-container">
    <h2>🎫 긴급 쿠폰함</h2>
    
    <div class="coupon-item">
        <div class="coupon-info">
            <div class="coupon-name">긴급 안마 쿠폰</div>
            <div class="coupon-count">남은 갯수: <span id="massage-count">-</span>장</div>
        </div>
        <button id="massage-btn" onclick="useCoupon('massage')">사용하기</button>
    </div>

    <div class="coupon-item">
        <div class="coupon-info">
            <div class="coupon-name">긴급 귀파기 쿠폰</div>
            <div class="coupon-count">남은 갯수: <span id="ear-count">-</span>장</div>
        </div>
        <button id="ear-btn" onclick="useCoupon('earCleaning')">사용하기</button>
    </div>
</div>

<script>
    // ⚠️ Firebase 설정 정보 (여기에 본인의 설정값을 넣으세요)
    const firebaseConfig = {
        apiKey: "YOUR_API_KEY",
        databaseURL: "YOUR_DATABASE_URL",
        projectId: "YOUR_PROJECT_ID",
        appId: "YOUR_APP_ID"
    };

    // Firebase 초기화
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    // 데이터 가져오기 및 실시간 동기화
    function initCoupons() {
        db.ref('coupons').on('value', (snapshot) => {
            const data = snapshot.val();
            
            // 데이터가 없으면 초기값(5장씩) 설정
            if (!data) {
                db.ref('coupons').set({
                    massage: 5,
                    earCleaning: 5
                });
                return;
            }

            // UI 업데이트
            updateUI('massage', data.massage);
            updateUI('earCleaning', data.earCleaning);
        });
    }

    function updateUI(type, count) {
        const countId = type === 'massage' ? 'massage-count' : 'ear-count';
        const btnId = type === 'massage' ? 'massage-btn' : 'ear-btn';
        
        document.getElementById(countId).innerText = count;
        
        // 0장이면 버튼 비활성화
        if (count <= 0) {
            document.getElementById(btnId).disabled = true;
            document.getElementById(btnId).innerText = "소진됨";
        } else {
            document.getElementById(btnId).disabled = false;
            document.getElementById(btnId).innerText = "사용하기";
        }
    }

    // 쿠폰 차감 함수
    function useCoupon(type) {
        if (!confirm('정말로 쿠폰을 사용하시겠습니까?')) return;

        const ref = db.ref('coupons/' + type);
        ref.transaction((currentCount) => {
            if (currentCount > 0) {
                return currentCount - 1;
            }
            return currentCount; // 0 이하일 경우 변경 없음
        });
    }

    // 앱 시작
    initCoupons();
</script>

</body>
</html>
